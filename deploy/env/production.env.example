# ATRETU production environment template
# Copy to /opt/atretu/env/atretu.env on the production server.
# File mode: 600. Owner: atretu service user.
# Never commit real secrets.

NODE_ENV=production

# Web
NEXT_PUBLIC_API_URL=https://<API_DOMAIN>
WEB_INTERNAL_PORT=<WEB_INTERNAL_PORT>

# API
API_PORT=<API_INTERNAL_PORT>
CORS_ORIGINS=https://<WEB_DOMAIN>
ALLOW_LOCALHOST_CORS_IN_PRODUCTION=false
TRUSTED_PROXY_HOPS=1

JWT_SECRET=<CHANGE_ME>
JWT_EXPIRES_IN=2h
ADMIN_BOOTSTRAP_ENABLED=false
# Only set this temporarily if ADMIN_BOOTSTRAP_ENABLED=true during a controlled setup window.
ADMIN_SETUP_TOKEN=
PASSWORD_HASH_ROUNDS=12

AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_MAX=5
RATE_LIMIT_MAX_BUCKETS=10000

# PostgreSQL
DATABASE_URL=<CHANGE_ME>

# Future shared services
REDIS_URL=

# Private files
DOCUMENT_STORAGE_DIR=/opt/atretu/storage/private-documents
DOCUMENT_MAX_SIZE_BYTES=8388608
BANK_SLIP_PDF_STORAGE_PATH=/opt/atretu/storage/private-documents/finance/bank-slips

# Sicredi - fill with controlled production or homologation values only.
SICREDI_ENV=production
SICREDI_AUTH_URL=https://<SICREDI_AUTH_HOST>/<SICREDI_AUTH_PATH>
SICREDI_BASE_URL=https://<SICREDI_API_HOST>/<SICREDI_API_BASE_PATH>
SICREDI_API_KEY=<sicredi-api-key>
SICREDI_USERNAME=<beneficiario-plus-cooperativa>
SICREDI_PASSWORD=<sicredi-password>
SICREDI_COOPERATIVA=<0000>
SICREDI_POSTO=<00>
SICREDI_CODIGO_BENEFICIARIO=<00000>
SICREDI_HTTP_TIMEOUT_MS=10000
SICREDI_REQUIRE_PAYER_ADDRESS=false

# Diagnostics and automatic jobs stay disabled for the first production boot.
SICREDI_ISSUE_DIAGNOSTICS_ENABLED=false
SICREDI_PDF_DIAGNOSTICS_ENABLED=false
SICREDI_SYNC_OPEN_ISSUED_ENABLED=false
SICREDI_SYNC_OPEN_ISSUED_INTERVAL_MS=900000
SICREDI_SYNC_OPEN_ISSUED_LIMIT=50
SICREDI_ISSUE_BATCH_ENABLED=false
SICREDI_ISSUE_BATCH_INTERVAL_MS=60000
SICREDI_ISSUE_BATCH_CONCURRENCY=2
SICREDI_ISSUE_BATCH_LIMIT=20
